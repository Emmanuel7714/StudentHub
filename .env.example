# Copy this file to .env and fill in what you need. None of these are
# required for local dev with the default JSON store + local file storage —
# `node server.js` works with zero env vars set.

# ---- Server ----
PORT=3000
# Set to "production" when actually deployed. This affects: Secure cookie
# flag (won't be set over plain HTTP in dev), whether X-Forwarded-For is
# trusted for rate limiting, and whether password-reset responses include
# the raw token (dev-only convenience — see routes/auth.js).
NODE_ENV=development

# How long a login session stays valid (server-side — previously only the
# cookie's own Max-Age implied this, but the server never actually checked
# session age, so a copied/leaked session token worked forever).
SESSION_MAX_AGE_DAYS=30

# ---- Admin bootstrap (Library/Marketplace) ----
# If set, an admin account is created (or an existing user with this email
# is promoted to admin) automatically on server start. Without this, there's
# no way into the admin upload form — see README.md for the manual alternative.
ADMIN_EMAIL=admin@uniben.edu.ng
ADMIN_PASSWORD=change-this-before-deploying
ADMIN_NAME=StudentHub Admin

# ---- Database (optional — defaults to the local JSON store) ----
# Set this to switch db/store.js over to Postgres. Requires: npm install pg
# Run db/schema.sql against this database first.
# DATABASE_URL=postgres://user:password@host:5432/studenthub

# ---- File storage (optional — defaults to local disk, dev only) ----
# Set STORAGE_PROVIDER=s3 for production (Render's filesystem is ephemeral).
# Requires: npm install @aws-sdk/client-s3 @aws-sdk/s3-request-presigner
# STORAGE_PROVIDER=s3
# S3_BUCKET=studenthub-resources
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=                 # set for Cloudflare R2 / Backblaze B2 / DO Spaces; omit for AWS S3
# S3_FORCE_PATH_STYLE=false    # some non-AWS providers need this set to true

# ---- Upload limits (optional) ----
MAX_PDF_MB=15

# ---- Payments (optional — Paystack). See PRODUCTION_READINESS.md: this
# code path (real HTTPS calls to Paystack, real webhook signature
# verification) has NOT been exercised against Paystack's live servers in
# the environment this was built in (no network access there). Without
# this key set, purchase-intent behaves exactly as before: creates a
# 'pending' purchase and says payment isn't connected yet.
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
